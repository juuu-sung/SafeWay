<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safeway_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="218dp"
            android:background="@drawable/bg_call_header"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="AI 안심 동행 통화"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/callStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="00:00 · 보호자 모드"
            android:textColor="#E8F5F2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_teal_soft"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/safeway_teal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/modeTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="true"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:minHeight="30dp"
            android:text="AI 보호자 모드"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="짧고 침착하게 안전 행동 안내"
            android:textColor="#E8F5F2"
            android:textSize="11sp"
            android:textStyle="bold" />
        </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_outline"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:padding="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/modeGroup"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/guardianModeButton"
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="보호자"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/friendModeButton"
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="친구"
                android:textColor="@color/safeway_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/boyfriendModeButton"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="남자친구"
                android:textColor="@color/safeway_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/girlfriendModeButton"
                android:layout_width="92dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="여자친구"
                android:textColor="@color/safeway_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/calmModeButton"
                android:layout_width="78dp"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="안내"
                android:textColor="@color/safeway_muted"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:id="@+id/chatScroll"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_card"
        android:fillViewport="true"
        android:minHeight="170dp"
        android:nestedScrollingEnabled="true"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/chatList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/riskPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_danger_soft"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="위험 상황일 수 있습니다."
            android:textColor="@color/safeway_danger"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="밝고 사람이 많은 장소로 이동하고, 필요하면 바로 112 또는 보호자에게 연락하세요."
            android:textColor="@color/safeway_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aiCall112Button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_danger"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="112"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aiGuardianButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="보호자"
            android:textColor="@color/safeway_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endCallButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dark_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="종료"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/autoConversationButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="자동 대화 켜기"
        android:textColor="@color/safeway_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/speakButton"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_teal"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="말하기"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
