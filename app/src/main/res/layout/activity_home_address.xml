<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/safeway_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="집 주소 설정"
                android:textColor="@color/safeway_ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="자주 쓰는 도착지를 집으로 저장해 바로 귀가 경로를 시작합니다."
                android:textColor="@color/safeway_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/homeStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:elevation="3dp"
                android:padding="18dp"
                android:text="저장된 집 주소가 없습니다."
                android:textColor="@color/safeway_ink"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:elevation="4dp">

                <com.kakao.vectormap.MapView
                    android:id="@+id/homeMap"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/homeMapCenterTarget"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_card"
                    android:elevation="8dp"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/safeway_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="집 주소"
                android:textColor="@color/safeway_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/homeAddressInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="예: 서울시 OO구 OO로 12"
                android:inputType="textPostalAddress"
                android:textColor="@color/safeway_ink"
                android:textColorHint="@color/safeway_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/searchHomePlaceButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_primary_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="카카오 장소 검색"
                android:textColor="@color/safeway_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/searchHomeAddressButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="입력한 주소 검색"
                android:textColor="@color/safeway_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pickHomeMapCenterButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="지도에서 선택"
                android:textColor="@color/safeway_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/saveHomeAddressButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="집 주소 저장하기"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startHomeReturnButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_teal"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="집으로 귀가 경로 시작"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/clearHomeAddressButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_danger_soft"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="저장된 집 주소 삭제"
                android:textColor="@color/safeway_danger"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/layout_bottom_nav" />
</LinearLayout>
