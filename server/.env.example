PORT=8080

# Kakao Developers REST API key for Local and Mobility walking directions.
KAKAO_REST_API_KEY=your-kakao-rest-api-key
KAKAO_MOBILITY_SERVICE=safeway

# Option A: path to a Firebase service account json file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json

# Option B: paste the whole service account json as one line instead.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OpenAI API key for AI companion chat and return-record summaries.
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.2
